{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Luckiest+Guy&family=Nunito:wght@400;700&display=swap" rel="stylesheet">

{%- liquid
  assign slide_blocks = section.blocks
  assign first_slide = slide_blocks | first
-%}

{%- if section.settings.image_height == 'adapt' and first_slide.settings.image != blank -%}
  {%- style -%}
    @media screen and (max-width: 749px) {
      #Slider-{{ section.id }}::before,
      #Slider-{{ section.id }} .banner__media::before,
      #Slider-{{ section.id }}:not(.banner--mobile-bottom) .banner__content::before {
        padding-bottom: {{ 1 | divided_by: first_slide.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }

    @media screen and (min-width: 750px) {
      #Slider-{{ section.id }}::before,
      #Slider-{{ section.id }} .banner__media::before {
        padding-bottom: {{ 1 | divided_by: first_slide.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
  {%- endstyle -%}
{%- endif -%}

{%- liquid
  assign full_width = '100vw'
  assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'

  if section.settings.image_behavior == 'ambient'
    assign full_width = '120vw'
    assign widths = '450, 660, 900, 1320, 1800, 2136, 2400, 3600, 7680'
  endif

  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

{%- if slide_blocks.size > 0 -%}
<!-- SVG crack/fracture filter for heading -->
<svg style="position:absolute;width:0;height:0;" aria-hidden="true">
  <defs>
    <filter id="banner-crack-filter">
      <feTurbulence type="fractalNoise" baseFrequency="0.04 0.12" numOctaves="4" seed="2" result="noise"/>
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="7" xChannelSelector="R" yChannelSelector="G" result="displaced"/>
      <feMorphology in="displaced" operator="erode" radius="0.3" result="cracked"/>
      <feMerge>
        <feMergeNode in="cracked"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
</svg>
<slideshow-component
  class="slider-mobile-gutter{% if section.settings.show_text_below %} mobile-text-below{% endif %}"
  role="region"
  aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
  aria-label="{{ section.settings.accessibility_info | default: 'Banner slideshow' | escape }}"
>
  {%- if slide_blocks.size > 1 -%}
    <button
      type="button"
      class="slider-button slider-button--prev slideshow__arrow slideshow__arrow--prev"
      name="previous"
      aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
      aria-controls="Slider-{{ section.id }}"
    >
      <span class="svg-wrapper">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </span>
    </button>
    <button
      type="button"
      class="slider-button slider-button--next slideshow__arrow slideshow__arrow--next"
      name="next"
      aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
      aria-controls="Slider-{{ section.id }}"
    >
      <span class="svg-wrapper">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </span>
    </button>
    <div class="slideshow__dots slider-buttons">
      <div class="slider-counter slider-counter--dots">
        <div class="slideshow__control-wrapper">
          {%- for block in slide_blocks -%}
            <button
              class="slider-counter__link slider-counter__link--dots link"
              aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
              aria-controls="Slider-{{ section.id }}"
            >
              <span class="dot"></span>
            </button>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  <div
    class="slideshow banner banner--{{ section.settings.image_height }} grid grid--1-col slider slider--everywhere{% if section.settings.show_text_below %} banner--mobile-bottom{% endif %}{% if first_slide.settings.image == blank %} slideshow--placeholder{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
    id="Slider-{{ section.id }}"
    aria-live="polite"
    aria-atomic="true"
    data-autoplay="{{ section.settings.auto_rotate }}"
    data-speed="{{ section.settings.change_slides_speed }}"
  >
    {%- for block in slide_blocks -%}
      <style>
        #Slide-{{ section.id }}-{{ forloop.index }} .banner__media::after {
          opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
        }
      </style>
      <div
        class="slideshow__slide grid__item grid--1-col slider__slide"
        id="Slide-{{ section.id }}-{{ forloop.index }}"
        {{ block.shopify_attributes }}
        role="group"
        aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
        aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
        tabindex="-1"
      >
        {%- if block.settings.image != blank -%}
          <div class="slideshow__media banner__media media{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}">
            {%- liquid
              assign height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round
              if section.settings.image_behavior == 'ambient'
                assign sizes = '120vw'
                assign slide_widths = '450, 660, 900, 1320, 1800, 2136, 2400, 3600, 7680'
              else
                assign sizes = '100vw'
                assign slide_widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
              endif
            -%}
            {%- if forloop.first -%}
              {{
                block.settings.image
                | image_url: width: 3840
                | image_tag: height: height, sizes: sizes, widths: slide_widths, fetchpriority: fetch_priority
              }}
            {%- else -%}
              {{
                block.settings.image
                | image_url: width: 3840
                | image_tag: loading: 'lazy', height: height, sizes: sizes, widths: slide_widths
              }}
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="slideshow__media banner__media media banner__media--cute-pattern">
            <svg class="banner__pattern-svg" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" preserveAspectRatio="xMidYMid slice" viewBox="0 0 800 600">
              <defs>
                <pattern id="cute-animals-{{ section.id }}-{{ forloop.index }}" x="0" y="0" width="200" height="200" patternUnits="userSpaceOnUse">
                  <circle cx="40" cy="40" r="10" fill="#F2789F" opacity="0.35"/>
                  <circle cx="28" cy="26" r="6" fill="#F2789F" opacity="0.3"/>
                  <circle cx="52" cy="26" r="6" fill="#F2789F" opacity="0.3"/>
                  <circle cx="22" cy="38" r="5" fill="#F2789F" opacity="0.25"/>
                  <circle cx="58" cy="38" r="5" fill="#F2789F" opacity="0.25"/>
                  <path d="M150,55 C150,45 140,40 135,45 C130,40 120,45 120,55 C120,65 135,75 135,75 C135,75 150,65 150,55Z" fill="#FFB6C1" opacity="0.3"/>
                  <circle cx="160" cy="150" r="8" fill="#E8629A" opacity="0.25"/>
                  <circle cx="150" cy="138" r="5" fill="#E8629A" opacity="0.2"/>
                  <circle cx="170" cy="138" r="5" fill="#E8629A" opacity="0.2"/>
                  <polygon points="50,130 53,140 63,140 55,146 58,156 50,150 42,156 45,146 37,140 47,140" fill="#FFD700" opacity="0.25"/>
                  <path d="M100,170 C100,162 92,158 88,162 C84,158 76,162 76,170 C76,178 88,186 88,186 C88,186 100,178 100,170Z" fill="#90CAF9" opacity="0.25"/>
                  <ellipse cx="100" cy="90" rx="12" ry="7" fill="#81C784" opacity="0.25"/>
                  <polygon points="114,90 124,82 124,98" fill="#81C784" opacity="0.2"/>
                  <rect x="40" y="178" width="20" height="6" rx="3" fill="#FFB74D" opacity="0.2"/>
                  <circle cx="38" cy="176" r="4" fill="#FFB74D" opacity="0.2"/>
                  <circle cx="38" cy="184" r="4" fill="#FFB74D" opacity="0.2"/>
                  <circle cx="62" cy="176" r="4" fill="#FFB74D" opacity="0.2"/>
                  <circle cx="62" cy="184" r="4" fill="#FFB74D" opacity="0.2"/>
                </pattern>
                <linearGradient id="cute-bg-{{ section.id }}-{{ forloop.index }}" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" style="stop-color:#FDDDE6;stop-opacity:1" />
                  <stop offset="35%" style="stop-color:#FCE4EC;stop-opacity:1" />
                  <stop offset="65%" style="stop-color:#E8F5E9;stop-opacity:1" />
                  <stop offset="100%" style="stop-color:#E3F2FD;stop-opacity:1" />
                </linearGradient>
              </defs>
              <rect width="800" height="600" fill="url(#cute-bg-{{ section.id }}-{{ forloop.index }})"/>
              <rect width="800" height="600" fill="url(#cute-animals-{{ section.id }}-{{ forloop.index }})"/>
            </svg>
          </div>
        {%- endif -%}

        <div class="slideshow__text-wrapper banner__content banner__content--{{ section.settings.desktop_content_position }} page-width{% if section.settings.show_text_box == false %} banner--desktop-transparent{% endif %}{% if settings.animations_reveal_on_scroll and forloop.index == 1 %} scroll-trigger animate--slide-in{% endif %}">
          <div class="slideshow__text banner__box content-container content-container--full-width-mobile color-{{ block.settings.color_scheme }} gradient banner--content-align-{{ section.settings.desktop_content_alignment }} banner--content-align-mobile-{{ section.settings.mobile_content_alignment }}">
            {%- if block.settings.heading != blank -%}
              <h2 class="banner__heading banner__heading--artistic inline-richtext {{ block.settings.heading_size }}">
                {{ block.settings.heading }}
              </h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="banner__text banner__text--artistic rte">
                <p>{{ block.settings.text }}</p>
              </div>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <div class="banner__buttons">
                <a
                  {% if block.settings.button_link != blank %}
                    href="{{ block.settings.button_link }}"
                  {% else %}
                    role="link" aria-disabled="true"
                  {% endif %}
                  class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                >
                  {{- block.settings.button_label | escape -}}
                </a>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>


</slideshow-component>
{%- endif -%}

<script>
  // Banner content fly-in — replay every time banner scrolls into view
  (function() {
    var flySelector = '.banner__heading--artistic, .banner__text--artistic, .banner__buttons';

    function resetContent(container) {
      container.querySelectorAll(flySelector).forEach(function(el) {
        el.classList.remove('banner-fly-in');
      });
    }

    function playContent(container) {
      var items = container.querySelectorAll(flySelector);
      items.forEach(function(el, i) {
        el.style.animationDelay = (i * 0.12) + 's';
        el.classList.add('banner-fly-in');
      });
    }

    function init() {
      var containers = document.querySelectorAll('slideshow-component');
      if (!containers.length) return;

      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            playContent(entry.target);
          } else {
            resetContent(entry.target);
          }
        });
      }, { threshold: 0.15 });

      containers.forEach(function(c) { observer.observe(c); });

      containers.forEach(function(comp) {
        comp.addEventListener('slideChanged', function() {
          setTimeout(function() { playContent(comp); }, 50);
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

{%- if request.design_mode -%}
  <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.image-banner.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "t:sections.image-banner.settings.image_overlay_opacity.label",
      "default": 40
    },
    {
      "type": "select",
      "id": "image_height",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.image-banner.settings.image_height.options__1.label"
        },
        {
          "value": "small",
          "label": "t:sections.image-banner.settings.image_height.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:sections.image-banner.settings.image_height.options__3.label"
        },
        {
          "value": "large",
          "label": "t:sections.image-banner.settings.image_height.options__4.label"
        }
      ],
      "default": "large",
      "label": "t:sections.image-banner.settings.image_height.label"
    },
    {
      "type": "select",
      "id": "image_behavior",
      "options": [
        {
          "value": "none",
          "label": "t:sections.all.animation.image_behavior.options__1.label"
        },
        {
          "value": "ambient",
          "label": "t:sections.all.animation.image_behavior.options__2.label"
        },
        {
          "value": "fixed",
          "label": "t:sections.all.animation.image_behavior.options__3.label"
        },
        {
          "value": "zoom-in",
          "label": "t:sections.all.animation.image_behavior.options__4.label"
        }
      ],
      "default": "none",
      "label": "t:sections.all.animation.image_behavior.label"
    },
    {
      "type": "header",
      "content": "Slideshow"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 9,
      "step": 1,
