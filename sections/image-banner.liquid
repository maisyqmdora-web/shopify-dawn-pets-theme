{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Luckiest+Guy&family=Nunito:wght@400;700&display=swap" rel="stylesheet">

{%- liquid
  assign slide_blocks = section.blocks
  assign first_slide = slide_blocks | first
-%}

{%- if section.settings.image_height == 'adapt' and first_slide.settings.image != blank -%}
  {%- style -%}
    @media screen and (max-width: 749px) {
      #Slider-{{ section.id }}::before,
      #Slider-{{ section.id }} .banner__media::before,
      #Slider-{{ section.id }}:not(.banner--mobile-bottom) .banner__content::before {
        padding-bottom: {{ 1 | divided_by: first_slide.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }

    @media screen and (min-width: 750px) {
      #Slider-{{ section.id }}::before,
      #Slider-{{ section.id }} .banner__media::before {
        padding-bottom: {{ 1 | divided_by: first_slide.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
  {%- endstyle -%}
{%- endif -%}

{%- liquid
  assign full_width = '100vw'
  assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'

  if section.settings.image_behavior == 'ambient'
    assign full_width = '120vw'
    assign widths = '450, 660, 900, 1320, 1800, 2136, 2400, 3600, 7680'
  endif

  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

{%- if slide_blocks.size > 0 -%}
<!-- SVG crack/fracture filter for heading -->
<svg style="position:absolute;width:0;height:0;" aria-hidden="true">
  <defs>
    <filter id="banner-crack-filter">
      <feTurbulence type="fractalNoise" baseFrequency="0.04 0.12" numOctaves="4" seed="2" result="noise"/>
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="7" xChannelSelector="R" yChannelSelector="G" result="displaced"/>
      <feMorphology in="displaced" operator="erode" radius="0.3" result="cracked"/>
      <feMerge>
        <feMergeNode in="cracked"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
</svg>
<slideshow-component
  class="slider-mobile-gutter{% if section.settings.show_text_below %} mobile-text-below{% endif %}"
  role="region"
  aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
  aria-label="{{ section.settings.accessibility_info | default: 'Banner slideshow' | escape }}"
>
  {%- if slide_blocks.size > 1 -%}
    <button
      type="button"
      class="slider-button slider-button--prev slideshow__arrow slideshow__arrow--prev"
      name="previous"
      aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
      aria-controls="Slider-{{ section.id }}"
    >
      <span class="svg-wrapper">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </span>
    </button>
    <button
      type="button"
      class="slider-button slider-button--next slideshow__arrow slideshow__arrow--next"
      name="next"
      aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
      aria-controls="Slider-{{ section.id }}"
    >
      <span class="svg-wrapper">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </span>
    </button>
    <div class="slideshow__dots slider-buttons">
      <div class="slider-counter slider-counter--dots">
        <div class="slideshow__control-wrapper">
          {%- for block in slide_blocks -%}
            <button
              class="slider-counter__link slider-counter__link--dots link"
              aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
              aria-controls="Slider-{{ section.id }}"
            >
              <span class="dot"></span>
            </button>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  <div
    class="slideshow banner banner--{{ section.settings.image_height }} grid grid--1-col slider slider--everywhere{% if section.settings.show_text_below %} banner--mobile-bottom{% endif %}{% if first_slide.settings.image == blank %} slideshow--placeholder{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
    id="Slider-{{ section.id }}"
    aria-live="polite"
    aria-atomic="true"
    data-autoplay="{{ section.settings.auto_rotate }}"
    data-speed="{{ section.settings.change_slides_speed }}"
  >
    {%- for block in slide_blocks -%}
      <style>
        #Slide-{{ section.id }}-{{ forloop.index }} .banner__media::after {
          opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
        }
        {%- liquid
          assign heading_offset_x = block.settings.heading_offset_x | default: 50 | minus: 50
          assign heading_offset_y = block.settings.heading_offset_y | default: 50 | minus: 50
          assign text_offset_x = block.settings.text_offset_x | default: 50 | minus: 50
          assign text_offset_y = block.settings.text_offset_y | default: 50 | minus: 50
          assign button_offset_x = block.settings.button_offset_x | default: 50 | minus: 50
          assign button_offset_y = block.settings.button_offset_y | default: 50 | minus: 50
          assign heading_mobile_offset_x = block.settings.heading_mobile_offset_x | default: 50 | minus: 50
          assign heading_mobile_offset_y = block.settings.heading_mobile_offset_y | default: 50 | minus: 50
          assign text_mobile_offset_x = block.settings.text_mobile_offset_x | default: 50 | minus: 50
          assign text_mobile_offset_y = block.settings.text_mobile_offset_y | default: 50 | minus: 50
          assign button_mobile_offset_x = block.settings.button_mobile_offset_x | default: 50 | minus: 50
          assign button_mobile_offset_y = block.settings.button_mobile_offset_y | default: 50 | minus: 50
        -%}
        #Slide-{{ section.id }}-{{ forloop.index }} .slideshow__text.banner__box {
          display: flex;
          flex-direction: column;
        }
        {%- if block.settings.heading_font_size != blank and block.settings.heading_font_size > 0 -%}
          {%- assign heading_mobile_size = block.settings.heading_font_size | times: 0.4 | round -%}
          {%- assign heading_vw = block.settings.heading_font_size | times: 0.067 | round: 1 -%}
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__heading {
            font-size: clamp({{ heading_mobile_size }}px, {{ heading_vw }}vw, {{ block.settings.heading_font_size }}px) !important;
          }
        {%- endif -%}
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__buttons .button:not(:hover):not(:focus-visible) {
            background-color: transparent !important;
          }
        {%- if block.settings.text_font_size != blank and block.settings.text_font_size > 0 -%}
          {%- assign text_mobile_size = block.settings.text_font_size | times: 0.5 | round -%}
          {%- assign text_vw = block.settings.text_font_size | times: 0.067 | round: 1 -%}
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__text p {
            font-size: clamp({{ text_mobile_size }}px, {{ text_vw }}vw, {{ block.settings.text_font_size }}px) !important;
          }
        {%- endif -%}
        {%- if block.settings.button_font_size != blank and block.settings.button_font_size > 0 -%}
          {%- assign button_mobile_size = block.settings.button_font_size | times: 0.4
             | round -%}
          {%- assign button_vw = block.settings.button_font_size | times: 0.067 | round: 1 -%}
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__buttons .button {
            font-size: clamp({{ button_mobile_size }}px, {{ button_vw }}vw, {{ block.settings.button_font_size }}px) !important;
          }
        {%- endif -%}

        {%- if heading_offset_x != 0 or heading_offset_y != 0 -%}
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__heading {
            position: relative;
            left: {{ heading_offset_x }}vw;
            top: {{ heading_offset_y }}vh;
          }
        {%- endif -%}
        {%- if text_offset_x != 0 or text_offset_y != 0 -%}
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__text {
            position: relative;
            left: {{ text_offset_x }}vw;
            top: {{ text_offset_y }}vh;
          }
        {%- endif -%}
        {%- if button_offset_x != 0 or button_offset_y != 0 -%}
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__buttons {
            position: relative;
            left: {{ button_offset_x }}vw;
            top: {{ button_offset_y }}vh;
          }
        {%- endif -%}
        {%- if block.settings.enable_mobile_position_adjustments -%}
          @media screen and (max-width: 749px) {
            {%- if heading_mobile_offset_x != 0 or heading_mobile_offset_y != 0 -%}
              #Slide-{{ section.id }}-{{ forloop.index }} .banner__heading {
                position: relative;
                left: {{ heading_mobile_offset_x }}vw;
                top: {{ heading_mobile_offset_y }}vh;
              }
            {%- endif -%}
            {%- if text_mobile_offset_x != 0 or text_mobile_offset_y != 0 -%}
              #Slide-{{ section.id }}-{{ forloop.index }} .banner__text {
                position: relative;
                left: {{ text_mobile_offset_x }}vw;
                top: {{ text_mobile_offset_y }}vh;
              }
            {%- endif -%}
            {%- if button_mobile_offset_x != 0 or button_mobile_offset_y != 0 -%}
              #Slide-{{ section.id }}-{{ forloop.index }} .banner__buttons {
                position: relative;
                left: {{ button_mobile_offset_x }}vw;
                top: {{ button_mobile_offset_y }}vh;
              }
            {%- endif -%}
          }
        {%- endif -%}
        {%- if block.settings.heading_color != blank -%}
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__heading {
            color: {{ block.settings.heading_color }};
          }
        {%- endif -%}
        {%- if block.settings.text_color != blank -%}
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__text,
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__text p {
            color: {{ block.settings.text_color }};
          }
        {%- endif -%}
        {%- liquid
          assign heading_font_css = ''
          case block.settings.heading_font_family
            when 'luckiest_guy'
              assign heading_font_css = 'Luckiest Guy, cursive'
            when 'nunito'
              assign heading_font_css = 'Nunito, sans-serif'
            when 'system_sans'
              assign heading_font_css = '-apple-system, BlinkMacSystemFont, Segoe UI, sans-serif'
            when 'serif'
              assign heading_font_css = 'Georgia, Times New Roman, serif'
          endcase

          assign text_font_css = ''
          case block.settings.text_font_family
            when 'luckiest_guy'
              assign text_font_css = 'Luckiest Guy, cursive'
            when 'nunito'
              assign text_font_css = 'Nunito, sans-serif'
            when 'system_sans'
              assign text_font_css = '-apple-system, BlinkMacSystemFont, Segoe UI, sans-serif'
            when 'serif'
              assign text_font_css = 'Georgia, Times New Roman, serif'
          endcase
        -%}
        {%- if heading_font_css != '' -%}
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__heading {
            font-family: {{ heading_font_css }};
          }
        {%- endif -%}
        {%- if text_font_css != '' -%}
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__text,
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__text p {
            font-family: {{ text_font_css }};
          }
        {%- endif -%}
        {%- if block.settings.button_text_color != blank -%}
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__buttons .button {
            --color-button-text: {{ block.settings.button_text_color | color_extract: 'red' }}, {{ block.settings.button_text_color | color_extract: 'green' }}, {{ block.settings.button_text_color | color_extract: 'blue' }};
            color: rgb(var(--color-button-text));
            -webkit-text-fill-color: rgb(var(--color-button-text));
          }
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__buttons .button:hover,
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__buttons .button:focus-visible {
            color: rgb(var(--color-button-text));
            -webkit-text-fill-color: rgb(var(--color-button-text));
          }
        {%- endif -%}
        {%- if block.settings.button_bg_color != blank -%}
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__buttons .button {
            --color-button: {{ block.settings.button_bg_color | color_extract: 'red' }}, {{ block.settings.button_bg_color | color_extract: 'green' }}, {{ block.settings.button_bg_color | color_extract: 'blue' }};
            --alpha-button-background: 1;
            background-color: rgba(var(--color-button), var(--alpha-button-background));
          }
        {%- endif -%}
        {%- if block.settings.button_hover_bg_color != blank -%}
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__buttons .button {
            --banner-button-hover-bg-color: {{ block.settings.button_hover_bg_color | color_extract: 'red' }}, {{ block.settings.button_hover_bg_color | color_extract: 'green' }}, {{ block.settings.button_hover_bg_color | color_extract: 'blue' }};
          }
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__buttons .button:hover,
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__buttons .button:focus-visible {
            background-color: rgba(var(--banner-button-hover-bg-color), 1);
            filter: none;
          }
        {%- elsif block.settings.button_bg_color != blank -%}
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__buttons .button:hover,
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__buttons .button:focus-visible {
            background-color: rgba(var(--color-button), var(--alpha-button-background));
            filter: none;
          }
        {%- endif -%}
        {%- if block.settings.button_border_color != blank -%}
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__buttons .button {
            --banner-button-border-color: {{ block.settings.button_border_color | color_extract: 'red' }}, {{ block.settings.button_border_color | color_extract: 'green' }}, {{ block.settings.button_border_color | color_extract: 'blue' }};
            --banner-button-border-opacity: 1;
          }
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__buttons .button::after {
            box-shadow: 0 0 0 calc(var(--buttons-border-width) + var(--border-offset))
                rgba(var(--banner-button-border-color), var(--banner-button-border-opacity)),
              0 0 0 var(--buttons-border-width) rgba(var(--color-button), var(--alpha-button-background));
          }
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__buttons .button:not([disabled]):hover::after {
            box-shadow: 0 0 0 calc(var(--buttons-border-width) + 1.3px)
                rgba(var(--banner-button-border-color), var(--banner-button-border-opacity)),
              0 0 0 calc(var(--buttons-border-width) + 1px) rgba(var(--color-button), var(--alpha-button-background));
          }
        {%- endif -%}
        {%- if block.settings.button_link == blank -%}
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__buttons .button[aria-disabled='true'] {
            opacity: 0.5;
          }
        {%- endif -%}
        {%- if block.settings.button_lock_exact_color_on_hover -%}
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__buttons .button,
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__buttons .button:hover,
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__buttons .button:focus-visible {
            color: rgb(var(--color-button-text)) !important;
            -webkit-text-fill-color: rgb(var(--color-button-text)) !important;
            background-color: rgba(var(--color-button), var(--alpha-button-background)) !important;
            filter: none !important;
            opacity: 1 !important;
            text-shadow: none !important;
            transform: none !important;
            box-shadow: none !important;
            animation: none !important;
          }
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__buttons .button::after,
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__buttons .button:hover::after,
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__buttons .button:focus-visible::after {
            border: var(--buttons-border-width) solid rgb(var(--banner-button-border-color, var(--color-button-text)));
            box-shadow: none !important;
          }
        {%- endif -%}
      </style>
      <div
        class="slideshow__slide grid__item grid--1-col slider__slide"
        id="Slide-{{ section.id }}-{{ forloop.index }}"
        {{ block.shopify_attributes }}
        role="group"
        aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
        aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
        tabindex="-1"
      >
        {%- if block.settings.image != blank -%}
          <div class="slideshow__media banner__media media{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}">
            {%- liquid
              assign height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round
              if section.settings.image_behavior == 'ambient'
                assign sizes = '120vw'
                assign slide_widths = '450, 660, 900, 1320, 1800, 2136, 2400, 3600, 7680'
              else
                assign sizes = '100vw'
                assign slide_widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
              endif
            -%}
            {%- if forloop.first -%}
              {{
                block.settings.image
                | image_url: width: 3840
                | image_tag: height: height, sizes: sizes, widths: slide_widths, fetchpriority: fetch_priority
              }}
            {%- else -%}
              {{
                block.settings.image
                | image_url: width: 3840
                | image_tag: loading: 'lazy', height: height, sizes: sizes, widths: slide_widths
              }}
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="slideshow__media banner__media media banner__media--cute-pattern">
            <svg class="banner__pattern-svg" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" preserveAspectRatio="xMidYMid slice" viewBox="0 0 800 600">
              <defs>
                <pattern id="cute-animals-{{ section.id }}-{{ forloop.index }}" x="0" y="0" width="200" height="200" patternUnits="userSpaceOnUse">
                  <circle cx="40" cy="40" r="10" fill="#F2789F" opacity="0.35"/>
                  <circle cx="28" cy="26" r="6" fill="#F2789F" opacity="0.3"/>
                  <circle cx="52" cy="26" r="6" fill="#F2789F" opacity="0.3"/>
                  <circle cx="22" cy="38" r="5" fill="#F2789F" opacity="0.25"/>
                  <circle cx="58" cy="38" r="5" fill="#F2789F" opacity="0.25"/>
                  <path d="M150,55 C150,45 140,40 135,45 C130,40 120,45 120,55 C120,65 135,75 135,75 C135,75 150,65 150,55Z" fill="#FFB6C1" opacity="0.3"/>
                  <circle cx="160" cy="150" r="8" fill="#E8629A" opacity="0.25"/>
                  <circle cx="150" cy="138" r="5" fill="#E8629A" opacity="0.2"/>
                  <circle cx="170" cy="138" r="5" fill="#E8629A" opacity="0.2"/>
                  <polygon points="50,130 53,140 63,140 55,146 58,156 50,150 42,156 45,146 37,140 47,140" fill="#FFD700" opacity="0.25"/>
                  <path d="M100,170 C100,162 92,158 88,162 C84,158 76,162 76,170 C76,178 88,186 88,186 C88,186 100,178 100,170Z" fill="#90CAF9" opacity="0.25"/>
                  <ellipse cx="100" cy="90" rx="12" ry="7" fill="#81C784" opacity="0.25"/>
                  <polygon points="114,90 124,82 124,98" fill="#81C784" opacity="0.2"/>
                  <rect x="40" y="178" width="20" height="6" rx="3" fill="#FFB74D" opacity="0.2"/>
                  <circle cx="38" cy="176" r="4" fill="#FFB74D" opacity="0.2"/>
                  <circle cx="38" cy="184" r="4" fill="#FFB74D" opacity="0.2"/>
                  <circle cx="62" cy="176" r="4" fill="#FFB74D" opacity="0.2"/>
                  <circle cx="62" cy="184" r="4" fill="#FFB74D" opacity="0.2"/>
                </pattern>
                <linearGradient id="cute-bg-{{ section.id }}-{{ forloop.index }}" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" style="stop-color:#FDDDE6;stop-opacity:1" />
                  <stop offset="35%" style="stop-color:#FCE4EC;stop-opacity:1" />
                  <stop offset="65%" style="stop-color:#E8F5E9;stop-opacity:1" />
                  <stop offset="100%" style="stop-color:#E3F2FD;stop-opacity:1" />
                </linearGradient>
              </defs>
              <rect width="800" height="600" fill="url(#cute-bg-{{ section.id }}-{{ forloop.index }})"/>
              <rect width="800" height="600" fill="url(#cute-animals-{{ section.id }}-{{ forloop.index }})"/>
            </svg>
          </div>
        {%- endif -%}

        {%- liquid
          assign slide_position = section.settings.desktop_content_position
          assign slide_alignment = section.settings.desktop_content_alignment
        -%}
        <div class="slideshow__text-wrapper banner__content banner__content--{{ slide_position }} page-width{% if section.settings.show_text_box == false %} banner--desktop-transparent{% endif %}{% if settings.animations_reveal_on_scroll and forloop.index == 1 %} scroll-trigger animate--slide-in{% endif %}">
          <div class="slideshow__text banner__box content-container content-container--full-width-mobile color-{{ block.settings.color_scheme }} gradient banner--content-align-{{ slide_alignment }} banner--content-align-mobile-{{ section.settings.mobile_content_alignment }}">
            {%- if block.settings.heading != blank -%}
              <h2 class="banner__heading banner__heading--artistic inline-richtext h0">
                {{ block.settings.heading }}
              </h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="banner__text banner__text--artistic rte">
                <p>{{ block.settings.text }}</p>
              </div>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <div class="banner__buttons">
                <a
                  {% if block.settings.button_link != blank %}
                    href="{{ block.settings.button_link }}"
                  {% else %}
                    role="link" aria-disabled="true"
                  {% endif %}
                  class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                >
                  {{- block.settings.button_label | escape -}}
                </a>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>


</slideshow-component>
{%- endif -%}

<style>
  @media screen and (max-width: 749px) {
    /* Force overlay mode: image fills entire banner, text on top */
    .slideshow.banner.banner--mobile-bottom {
      flex-wrap: nowrap !important;
    }

    .slideshow.banner.banner--mobile-bottom .slideshow__slide {
      position: relative;
      display: flex;
      flex-direction: column;
    }

    .slideshow.banner.banner--mobile-bottom .banner__media {
      position: absolute !important;
      top: 0;
      left: 0;
      width: 100%;
      height: 100% !important;
    }

    .slideshow.banner.banner--mobile-bottom .banner__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .slideshow.banner.banner--mobile-bottom .slideshow__text-wrapper {
      position: relative;
      z-index: 2;
      min-height: 39rem;
      display: flex;
      align-items: flex-end;
      padding-bottom: 2rem;
    }

    .slideshow.banner.banner--mobile-bottom .slideshow__text.banner__box {
      background: transparent;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      border: 0;
      box-shadow: none;
      border-radius: 0;
      margin: 0;
      padding: 2rem 1.5rem;
    }

    .slideshow.banner.banner--mobile-bottom .slideshow__text.banner__box::after {
      display: none;
    }

    /* Scale button for mobile */
    .slideshow.banner .banner__buttons a {
      font-size: clamp(1.5rem, 3.8vw, 2.5rem) !important;
      padding: 1rem 2rem;
    }
    .slideshow.banner .banner__buttons a::after {
      box-shadow: 0 0 0 1px
        rgba(var(--banner-button-border-color, var(--color-button)), var(--banner-button-border-opacity, var(--alpha-button-background)));
    }
  }
</style>

<script>

  // Banner content fly-in — replay every time banner scrolls into view
  (function() {
    var flySelector = '.banner__heading--artistic, .banner__text--artistic, .banner__buttons';

    function resetElements(root) {
      if (!root) return;
      root.querySelectorAll(flySelector).forEach(function(el) {
        el.classList.remove('banner-fly-in');
        el.style.animationDelay = '';
        void el.offsetWidth; // force reflow so opacity:0 base state is applied
      });
    }

    function playElements(root) {
      if (!root) return;
      var items = root.querySelectorAll(flySelector);
      items.forEach(function(el, i) {
        el.classList.remove('banner-fly-in');
        void el.offsetWidth; // force reflow before re-adding class
        el.style.animationDelay = (i * 0.06) + 's';
        el.classList.add('banner-fly-in');
      });
    }

    function getActiveSlide(container) {
      // Try to find the currently visible (non-clone) slide
      var page = (container.currentPage || 1);
      var nonClones = Array.prototype.slice.call(
        container.querySelectorAll('.slideshow__slide:not(.slideshow__clone)')
      );
      return nonClones[page - 1] || nonClones[0];
    }

    function resolvePlayableSlide(container, slide) {
      if (!slide) return getActiveSlide(container);
      if (!slide.classList.contains('slideshow__clone')) return slide;
      var cloneId = slide.id || '';
      var sourceId = cloneId.replace(/-clone$/, '');
      if (sourceId) {
        var sourceSlide = document.getElementById(sourceId);
        if (sourceSlide && container.contains(sourceSlide)) return sourceSlide;
      }
      return getActiveSlide(container);
    }

    function init() {
      var containers = document.querySelectorAll('slideshow-component');
      if (!containers.length) return;

      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          var comp = entry.target;
          // Reset ALL slides first
          comp.querySelectorAll('.slideshow__slide:not(.slideshow__clone)').forEach(function(s) {
            resetElements(s);
          });
          if (entry.isIntersecting) {
            // Small delay to let reset fully apply, then play active slide
            setTimeout(function() {
              playElements(getActiveSlide(comp));
            }, 30);
          }
        });
      }, { threshold: 0.15 });

      containers.forEach(function(c) { observer.observe(c); });

      containers.forEach(function(comp) {
        comp.addEventListener('slideChanged', function(event) {
          var rawCurrentSlide = event.detail && event.detail.currentElement;
          var currentSlide = resolvePlayableSlide(comp, rawCurrentSlide);
          if (!currentSlide) return;

          comp.querySelectorAll('.slideshow__slide:not(.slideshow__clone)').forEach(function(s) {
            if (s !== currentSlide) resetElements(s);
          });

          setTimeout(function() { playElements(currentSlide); }, 50);
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

